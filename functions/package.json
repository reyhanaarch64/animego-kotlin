{
  "name": "animego-firebase-functions",
  "private": true,
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc",
    "serve": "npm run build && firebase emulators:start --only auth,database,functions",
    "deploy": "firebase deploy --only functions,database",
    "test:rules": "cd .. && firebase emulators:exec --only database \"node --test functions/tests/database.rules.test.mjs\""
  },
  "dependencies": {
    "firebase-admin": "^13.5.0",
    "firebase-functions": "^6.4.0"
  },
  "devDependencies": {
    "firebase-tools": "^14.15.0",
    "typescript": "^5.9.3",
    "@firebase/rules-unit-testing": "^4.0.1",
    "firebase": "^12.3.0"
  }
}